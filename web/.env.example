# 이 파일을 .env.local 로 복사해서 사용합니다.

# API 기본 주소. 로컬에서는 비워 두면 /api/... 요청이 dev 서버 프록시로 갑니다.
VITE_API_BASE_URL=

# dev 서버 프록시가 요청을 넘길 BE 주소 (기본값 http://127.0.0.1:4174)
# BE 저장소에서 `python -m agent.console --port 4174` 로 실행합니다.
VITE_API_PROXY_TARGET=http://127.0.0.1:4174

# true 이면 BE 없이 MSW mock 으로 실행합니다. (`npm run dev:mock` 은 .env.mock 을 사용)
VITE_USE_MOCK_API=false
