# 이 파일을 .env.local 로 복사해서 사용합니다.

# API 기본 주소. 로컬에서는 비워 둡니다. /api/... 요청이 dev 서버 프록시로 갑니다.
# 실서버 주소를 직접 넣으면 다른 origin 이 되어 로그인 쿠키(csrftoken·sessionid, Secure)가 저장되지 않습니다.
VITE_API_BASE_URL=

# dev 서버 프록시가 요청을 넘길 BE 주소. 실서버를 씁니다.
VITE_API_PROXY_TARGET=http://43.200.218.110

# true 이면 BE 없이 MSW mock 으로 실행합니다. (`npm run dev:mock` 은 .env.mock 을 사용)
VITE_USE_MOCK_API=false

# Google Identity Services 클라이언트 ID (BE 에서 받은 값, 공개 식별자).
# Google 에는 http://localhost:5173 만 등록돼 있어 다른 포트·주소에서는 구글 로그인이 안 됩니다.
VITE_GOOGLE_CLIENT_ID=
